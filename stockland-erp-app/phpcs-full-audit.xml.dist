<?xml version="1.0"?>
<ruleset name="Stockland ERP Full-Source Audit">
    <description>Full-scope WordPress PHP coding-standard audit profile. Run separately to surface legacy and new-source findings across the whole plugin; this profile is not represented as passing until PHPCS/WPCS executes in an environment with Composer dependencies.</description>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <rule ref="WordPress"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>
    <config name="minimum_supported_wp_version" value="6.8"/>
    <config name="testVersion" value="8.4-"/>
    <file>stockland-inventory.php</file>
    <file>uninstall.php</file>
    <file>includes</file>
    <file>templates</file>
    <file>tests</file>
    <file>tools/qa</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
