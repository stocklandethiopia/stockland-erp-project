<?xml version="1.0"?>
<ruleset name="Stockland ERP Enterprise PHP Standard">
    <description>Targeted production-service coding standard for the sequence, money and integrity components. QA scripts and PHPUnit fixtures are verified by syntax checks and executable regression suites; the separate full-audit profile includes all PHP files to inventory legacy style findings.</description>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <rule ref="WordPress"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>
    <config name="minimum_supported_wp_version" value="6.8"/>
    <config name="testVersion" value="8.4-"/>
    <file>includes/class-stockland-sequence.php</file>
    <file>includes/class-stockland-money.php</file>
    <file>includes/class-stockland-integrity.php</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
