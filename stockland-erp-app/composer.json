{
  "name": "stockland/stockland-ethiopia-erp",
  "description": "Stockland Ethiopia ERP enterprise QA, unit tests and coding-standard configuration.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {},
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "lint:php": "phpcs --standard=phpcs.xml.dist",
    "qa": "php tools/qa/run-static-qa.php",
    "lint:php:full": "phpcs --standard=phpcs-full-audit.xml.dist"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
